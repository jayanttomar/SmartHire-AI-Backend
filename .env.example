DB_URL=jdbc:postgresql://localhost:5432/smarthire_ai
DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads/resumes
ANTHROPIC_API_KEY=your_claude_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PASSWORD_RESET_EXPIRATION_MINUTES=30
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Hosting: set SPRING_PROFILES_ACTIVE=prod in your deployment environment.
# Use a real HTTPS domain for FRONTEND_URL and a cryptographically random JWT_SECRET (32+ characters).
